# --- Core ---
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Leave DATABASE_URL empty to use local SQLite (development).
# For production (Render/Railway/etc) set e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Email (used for contact form notifications) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
CONTACT_RECEIVER_EMAIL=your-email@gmail.com

# --- Site ---
SITE_NAME=Your Name | Portfolio
SITE_DOMAIN=http://127.0.0.1:8000
